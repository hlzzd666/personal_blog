APP_NAME=Personal Blog API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=mysql+pymysql://root:your_mysql_password@127.0.0.1:3306/personal_blog?charset=utf8mb4
SQL_ECHO=false
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
TRUSTED_PROXY_IPS=
PUBLIC_BASE_URL=http://127.0.0.1:8000
REDIS_URL=redis://127.0.0.1:6379/0
ARTICLE_LIST_CACHE_TTL=300
ARTICLE_VISITOR_IDENTITY_SECRET=replace-with-a-long-random-secret-in-production
