APP_NAME=Personal Blog API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=mysql+pymysql://root:your_mysql_password@127.0.0.1:3306/personal_blog?charset=utf8mb4
SQL_ECHO=false
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
TRUSTED_PROXY_IPS=
PUBLIC_BASE_URL=http://127.0.0.1:8000
SITE_URL=http://127.0.0.1:5173
WEB_BASE_PATH=/web
WEB_DIST_DIR=web/dist
UPLOAD_DIR=backend/uploads
# 媒体存储：local 或 oss。生产环境建议使用 OSS，密钥只放在服务器环境变量中。
MEDIA_STORAGE_DRIVER=local
OSS_ENDPOINT=https://oss-cn-your-region.aliyuncs.com
OSS_BUCKET=your-bucket
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 可填写 CDN 或自定义域名；留空时按 bucket.endpoint 生成公开 URL。
OSS_PUBLIC_BASE_URL=
# 本地使用 dev；生产服务器必须改为 personal-blog/prod，避免混用图片目录。
OSS_OBJECT_PREFIX=personal-blog/dev
REDIS_URL=redis://127.0.0.1:6379/0
ARTICLE_LIST_CACHE_TTL=300
ARTICLE_VISITOR_IDENTITY_SECRET=replace-with-a-long-random-secret-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_SESSION_COOKIE_NAME=personal_blog_admin_session
ADMIN_CSRF_COOKIE_NAME=personal_blog_admin_csrf
COOKIE_SECURE=false
DAILY_LEARNING_ENCRYPTION_KEY=
